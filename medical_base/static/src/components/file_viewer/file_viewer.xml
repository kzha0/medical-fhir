<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="web.FileViewer" t-inherit-mode="extension" owl="1">
        <xpath expr="//span[@class='text-truncate']" position="attributes">
            <attribute name="t-out">state.file.displayName || state.file.name</attribute>
        </xpath>
    </t>

</templates>
