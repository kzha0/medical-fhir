<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">


   <t
        t-name="medical_base.One2manyPatientField"
        t-inherit="web.X2ManyField"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
            <button
                type="button"
                class="btn btn-secondary"
                title="Add Existing record"
                accesskey="c"
                t-on-click.stop.prevent="() => this.onAddLink()"
            >
                <t t-esc="linkButtonText" />
            </button>
        </xpath>
    </t>
</templates>
