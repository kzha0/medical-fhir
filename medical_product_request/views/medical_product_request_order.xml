<odoo>
    <record model="ir.ui.view" id="medical_product_request_order_form_view">
        <field
            name="name"
        >medical.product.request.order.form (in medical_product_request)</field>
        <field name="model">medical.product.request.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Validate"
                        name="validate_action"
                        invisible="state != 'draft'"
                        type="object"
                        class="btn-success"
                    />
                    <button
                        string="Complete"
                        name="complete_action"
                        invisible="state != 'active'"
                        type="object"
                        class="btn-success"
                    />
                    <button
                        string="Cancel"
                        name="cancel_action"
                        invisible="state not in ['draft', 'active', 'completed']"
                        type="object"
                        class="btn-danger"
                    />
                    <field name="state" widget="statusbar" nolabel="1" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        text="Completed"
                        bg_color="bg-success"
                        invisible="state != 'completed'"
                    />
                    <widget
                        name="web_ribbon"
                        text="Cancelled"
                        bg_color="bg-danger"
                        invisible="state != 'cancelled'"
                    />
                    <h2>
                        <label for="internal_identifier" />
                        <field name="internal_identifier" readonly="1" />
                    </h2>
                    <group name="patient">
                        <field
                            name="encounter_warning"
                            nolabel="1"
                            decoration-danger="1"
                            colspan="2"
                            invisible="not show_encounter_warning"
                        />
                        <field name="show_encounter_warning" invisible="1" />
                        <group>
                            <field name="patient_id" readonly="1" force_save="1" />
                            <field
                                name="encounter_id"
                                widget="selection"
                                readonly="False"
                                domain="[('patient_id', '=', patient_id)]"
                                readonly="state != 'draft'"
                            />
                            <field name="category" invisible="1" />
                        </group>
                        <group>
                            <field
                                name="requester_id"
                                invisible="state not in ['active', 'completed', 'cancelled']"
                            />
                            <field
                                name="validation_date"
                                invisible="state not in ['active', 'completed', 'cancelled']"
                            />
                            <field name="cancel_date" invisible="state != 'cancelled'" readonly="1" />
                            <field
                                name="cancel_user_id"
                                invisible="state != 'cancelled'"
                                readonly="1"
                            />
                            <field name="can_administrate" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="prescriptions" string="Prescriptions" required="1">
                            <field
                                name="product_request_ids"
                                readonly="state != 'draft'"
                            >
                                <list
                                    editable="bottom"
                                    decoration-muted="state == 'cancelled'"
                                >
                                    <field
                                        name="medical_product_template_id"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field
                                        name="dose_quantity"
                                        string="Dose"
                                        required="1"
                                    />
                                    <field name="dose_uom_domain" invisible="1" />
                                    <field
                                        name="dose_uom_id"
                                        string="Uom"
                                        domain="dose_uom_domain"
                                        options="{'no_create': True, 'no_open': True}"
                                        required="1"
                                    />
                                    <field
                                        name="rate_quantity"
                                        string="Rate"
                                        invisible="product_type != 'medication'"
                                    />
                                    <field
                                        name="rate_uom_id"
                                        string="Uom"
                                        invisible="product_type != 'medication'" required="product_type == 'medication'"
                                        domain="[('category_id', '=', %(uom.uom_categ_wtime)s)]"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field name="category" invisible="1" />
                                    <field name="product_type" invisible="1" />
                                    <field
                                        name="duration"
                                        string="Duration"
                                        invisible="product_type != 'medication'"
                                    />
                                    <field
                                        name="duration_uom_id"
                                        string="Uom"
                                        invisible="product_type != 'medication'" required="product_type == 'medication'"
                                        domain="[('category_id', '=', %(uom.uom_categ_wtime)s)]"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field
                                        name="administration_route_id"
                                        string="Adm. Route"
                                        domain="administration_route_domain"
                                        options="{'no_create': True, 'no_open': True}"
                                        column_invisible="parent.category != 'inpatient'" invisible="product_type != 'medication'"
                                    />
                                    <field
                                        name="administration_route_domain"
                                        invisible="1"
                                    />
                                    <field name="observations" />
                                    <field
                                        name="medical_product_id"
                                        column_invisible="parent.category != 'discharge'"
                                    />
                                    <field
                                        name="quantity_to_dispense"
                                        column_invisible="parent.category != 'discharge'"
                                    />
                                    <field name="can_administrate" invisible="1" />
                                    <button
                                        name="create_medical_product_administration"
                                        class="btn btn-link text-left"
                                        type="object"
                                        icon="fa-hand-holding-medical"
                                        string="Administrate"
                                        column_invisible="not parent.can_administrate or parent.category == 'discharge'" invisible="not can_administrate"
                                    />
                                    <field
                                        name="product_administrations_count"
                                        class="text-right"
                                        string="Administrations"
                                        column_invisible="not parent.can_administrate or parent.category == 'discharge'"
                                    />
                                    <button
                                        name="action_view_medical_product_administration"
                                        class="btn btn-link text-left"
                                        type="object"
                                        icon="fa-solid fa-prescription-bottle"
                                        string="View Administrations"
                                        invisible="state == 'draft'" column_invisible="parent.category == 'discharge'"
                                    />
                                    <field name="state" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_product_request_order_search_view">
        <field
            name="name"
        >medical.product.request.order.search (in medical_product_request)</field>
        <field name="model">medical.product.request.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="encounter_id" />
                <field name="medical_product_template_id" />
                <field name="internal_identifier" />
                <field name="requester_id" />
                <filter
                    name="not_cancelled"
                    string="Not Cancelled"
                    domain="[('state', '!=', 'cancelled')]"
                />
                <filter
                    name="my_medical_orders"
                    string="My Medical Orders"
                    domain="[('requester_id', '=', uid )]"
                />
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_product_request_order_list_view">
        <field
            name="name"
        >medical.product.request.order.list (in medical_product_request)</field>
        <field name="model">medical.product.request.order</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state == 'cancelled'"
                decoration-warning="state == 'draft'"
            >
                <field name="internal_identifier" />
                <field name="patient_id" invisible="1" />
                <field name="encounter_id" />
                <field name="medical_product_template_ids" widget="many2many_tags" />
                <field name="requester_id" />
                <field name="validation_date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record
        model="ir.actions.act_window"
        id="external_medical_product_request_order_act_window"
    >
        <field name="name">External Prescriptions</field>
        <field name="res_model">medical.product.request.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'discharge')]</field>
        <field
            name="context"
        >{'search_default_not_cancelled':1, 'default_category': 'discharge'}</field>
    </record>
    <record
        model="ir.actions.act_window"
        id="internal_medical_product_request_order_act_window"
    >
        <field name="name">Internal Medical Orders</field>
        <field name="res_model">medical.product.request.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'inpatient')]</field>
        <field
            name="context"
        >{'search_default_not_cancelled':1, 'default_category': 'inpatient'}</field>
    </record>
</odoo>
