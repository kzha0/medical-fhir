<odoo>
    <record model="ir.ui.view" id="medical_procedure_external_request_form_view">
        <field
            name="name"
        >medical.procedure.external.request.form (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="medical_base.medical_event_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="draft2final_action"
                    string="Issue request"
                    class="btn-success"
                    confirm="Are you sure you want to validate this external request?"
                    type="object"
                    invisible="state != 'draft'"
                />
                <button
                    name="cancel_action"
                    string="Cancel request"
                    confirm="Are you sure you want to cancel this external request?"
                    class="btn-danger"
                    type="object"
                    invisible="not is_cancellable"
                />
            </header>
            <xpath expr="//div[@name='button_box']" position="before">
                <widget
                    name="web_ribbon"
                    title="Final"
                    bg_color="bg-success"
                    invisible="state != 'final'"
                />
                <widget
                    name="web_ribbon"
                    title="Cancelled"
                    bg_color="bg-danger"
                    invisible="state != 'cancelled'"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="show_signature"
                    class="oe_stat_button"
                    icon="fa-signature"
                    string="Signature"
                    invisible="not signature_date"
                >
                    <field name="signature_date" invisible="1" />
                </button>
            </xpath>
            <xpath expr="//form" position="attributes">
                <attribute name="string">External Request</attribute>
            </xpath>
            <field name="patient_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="patient_id" position="before">
                <field
                    name="patient_name"
                    readonly="state != 'draft'"
                />
                <field name="encounter_id" />
                <field name="vat" readonly="state != 'draft'" />
                <field
                    name="patient_age"
                    readonly="state != 'draft'"
                />
                <field
                    name="patient_origin"
                    readonly="state != 'draft'"
                />
                <field name="is_cancellable" invisible="1" />
            </field>
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,final</attribute>
            </field>
            <field name="service_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="performer_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="occurrence_date" position="after">
                <field name="issued_date" />
                <field name="issued_user_id" invisible="state not in ('final', 'cancelled')" />
                <field name="cancel_date" invisible="state != 'cancelled'" />
                <field name="cancel_user_id" invisible="state != 'cancelled'" />
            </field>
            <xpath expr="//notebook/page[1]" position="before">
                <page name="composition" string="Composition">
                    <field
                        name="composition"
                        options="{'automatic_summernote_height': 1}"
                        readonly="state != 'draft'"
                    />
                </page>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_procedure_external_request_search_view">
        <field
            name="name"
        >medical.procedure.external.request.search (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="internal_identifier" />
                <separator />
                <filter
                    name="filter_not_cancelled"
                    string="Not cancelled"
                    domain="[('state', '!=', 'cancelled')]"
                />
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_procedure_external_request_list_view">
        <field
            name="name"
        >medical.procedure.external.request.list (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="medical_base.medical_event_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="string">External Request</attribute>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">state == 'draft'</attribute>
                <attribute name="decoration-muted">state == 'cancelled'</attribute>
            </xpath>
            <list>
                <field name="issued_date" />
                <field name="state" invisible="1" />
            </list>
        </field>
    </record>
    <record
        model="ir.actions.act_window"
        id="medical_procedure_external_request_act_window"
    >
        <field name="name">External Request</field>
        <field name="res_model">medical.procedure.external.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record model="ir.ui.menu" id="medical_procedure_external_request_menu">
        <field name="name">External Request</field>
        <field name="parent_id" ref="medical_root_request" />
        <field name="action" ref="medical_procedure_external_request_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
